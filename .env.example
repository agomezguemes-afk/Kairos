# KAIROS — Environment template
#
# Copy this file to one of (uncommitted):
#   .env.development   ← active when APP_ENV=development (default)
#   .env.staging       ← active when APP_ENV=staging
#   .env.production    ← active when APP_ENV=production
#
# Then run:
#   npm run env:dev      → symlinks .env → .env.development
#   npm run env:staging  → symlinks .env → .env.staging
#   npm run env:prod     → symlinks .env → .env.production
#
# Expo inlines any variable prefixed with `EXPO_PUBLIC_` into the JS
# bundle at build time. Restart the dev server after changing the env.
#
# Dev and staging may safely share the same Supabase project (the DEV
# one). Production must point at the prod Supabase. Groq key can be the
# same across envs.

# ── Supabase ──────────────────────────────────────────────────────────
# Project URL: visible in the dashboard URL.
# Anon key:    Settings → API → Project API keys → "anon / public".
# Safe to expose; Row-Level Security gates access.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Groq (Kai assistant) ──────────────────────────────────────────────
# Free tier, no credit card. Sign up: https://console.groq.com
# If empty, Kai falls back to the offline mock so the chat never breaks.
EXPO_PUBLIC_GROQ_API_KEY=
